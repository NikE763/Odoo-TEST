<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_ksa_retention" model="ir.ui.view">
        <field name="name">res.partner.form.ksa.retention</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_ksa_release_retention"
                        icon="fa-unlock-alt" string="Release Retention"
                        groups="account.group_account_manager"
                        invisible="not is_company and parent_id"/>
            </xpath>
        </field>
    </record>
</odoo>
