<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_ksa_retention" model="ir.ui.view">
        <field name="name">account.move.form.ksa.retention</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- generated entries are reset through their source document -->
            <xpath expr="//button[@name='button_draft']" position="attributes">
                <attribute name="invisible">not show_reset_to_draft_button or ksa_entry_kind</attribute>
            </xpath>
            <xpath expr="//button[@name='button_draft']" position="after">
                <button name="action_ksa_undo_release" string="Undo Retention Release" type="object"
                        groups="account.group_account_manager"
                        invisible="ksa_entry_kind != 'release' or state != 'posted'"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Retention &amp; Advance" name="ksa_retention"
                      invisible="move_type != 'out_invoice'">
                    <field name="ksa_entry_kind" invisible="1"/>
                    <field name="commercial_partner_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <group>
                        <group string="Retention" name="ksa_retention_group">
                            <field name="ksa_retention_percent" readonly="state != 'draft'"/>
                            <field name="ksa_handover_date" readonly="state != 'draft'"/>
                            <field name="ksa_retention_balance" invisible="state != 'posted' or not ksa_hold_move_id"/>
                        </group>
                        <group string="Advance Recovery" name="ksa_advance_group">
                            <field name="ksa_advance_payment_id" readonly="state != 'draft'"
                                   options="{'no_create': True}"
                                   domain="[('ksa_is_advance', '=', True), ('payment_type', '=', 'inbound'), ('partner_id', 'child_of', commercial_partner_id), ('company_id', '=', company_id), ('move_id.state', '=', 'posted')]"/>
                            <field name="ksa_advance_remaining"
                                   invisible="not ksa_advance_payment_id or state != 'draft'"/>
                            <field name="ksa_recovery_type" widget="radio" readonly="state != 'draft'"
                                   invisible="not ksa_advance_payment_id"/>
                            <field name="ksa_recovery_percent" readonly="state != 'draft'"
                                   invisible="not ksa_advance_payment_id or ksa_recovery_type != 'percent'"/>
                            <field name="ksa_recovery_fixed" readonly="state != 'draft'"
                                   invisible="not ksa_advance_payment_id or ksa_recovery_type != 'fixed'"/>
                        </group>
                    </group>
                    <group name="ksa_summary_group">
                        <group string="Amount to Pay Now" name="ksa_summary">
                            <field name="amount_total" string="Invoice Total"/>
                            <field name="ksa_retention_amount"/>
                            <field name="ksa_advance_recovery_amount"/>
                            <field name="ksa_amount_due_now" class="fw-bold"/>
                        </group>
                        <group string="Generated Entries" name="ksa_entries"
                               invisible="not ksa_hold_move_id and not ksa_credit_move_id">
                            <field name="ksa_hold_move_id" invisible="not ksa_hold_move_id"/>
                            <field name="ksa_credit_move_id" invisible="not ksa_credit_move_id"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
