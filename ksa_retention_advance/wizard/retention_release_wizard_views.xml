<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ksa_retention_release_wizard_form" model="ir.ui.view">
        <field name="name">ksa.retention.release.wizard.form</field>
        <field name="model">ksa.retention.release.wizard</field>
        <field name="arch" type="xml">
            <form string="Release Retention">
                <field name="currency_id" invisible="1"/>
                <group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="partner_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="release_date"/>
                    </group>
                    <group>
                        <field name="release_type" widget="radio"/>
                        <field name="amount" invisible="release_type != 'partial'"
                               required="release_type == 'partial'"/>
                        <field name="total_release"/>
                    </group>
                </group>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="currency_id" column_invisible="1"/>
                        <field name="retention_line_id" column_invisible="1"/>
                        <field name="selected"/>
                        <field name="move_id"/>
                        <field name="sale_order_id" optional="show"/>
                        <field name="handover_date"/>
                        <field name="retention_balance"/>
                        <field name="release_amount"/>
                    </list>
                </field>
                <footer>
                    <button name="action_release" string="Release" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ksa_retention_release" model="ir.actions.act_window">
        <field name="name">Release Retention</field>
        <field name="res_model">ksa.retention.release.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
